HOST=127.0.0.1
PORT=8787
DATA_FILE=./data/local-store.json
MAX_CAPTURE_BODY_BYTES=1048576
METADATA_FETCH_TIMEOUT_MS=10000
METADATA_MAX_BYTES=262144
CAPTIONS_FETCH_TIMEOUT_MS=10000
CAPTIONS_MAX_BYTES=524288

# Expo public runtime setting for a deployed API. This is a URL, not a secret.
# EXPO_PUBLIC_API_URL=https://svi-api-dwstx3p4nq-ue.a.run.app

# Firebase client configuration for the Expo app. These are public client
# identifiers, not service-account credentials. Keep real values in an ignored
# apps/mobile/.env file; never put provider or server credentials here.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=saved-video-intelligence.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=saved-video-intelligence
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=saved-video-intelligence.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Set FIRESTORE_ENABLED=true only when Firebase Admin credentials/ADC are available.
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=saved-video-intelligence
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Worker runtime settings. Production workers should use Cloud Run IAM and ADC.
WORKER_HOST=127.0.0.1
WORKER_PORT=8080
WORKER_STAGE=transcribing
# WORKER_AUTH_TOKEN=
WORKER_TRUST_CLOUD_RUN_IAM=false

# GitHub repository discovery. Keep this enabled only on the backend worker.
GITHUB_DISCOVERY_ENABLED=false
# GITHUB_TOKEN=

# Production API queue dispatch. Keep disabled until stage worker URLs are
# deployed and Cloud Run Invoker permissions have been granted to the task
# dispatcher identity.
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_PROJECT_ID=saved-video-intelligence
CLOUD_TASKS_LOCATION=us-east1
CLOUD_TASKS_QUEUE=svi-processing
# CLOUD_TASKS_WORKER_URL=https://svi-transcription-worker-dwstx3p4nq-ue.a.run.app/tasks/process
# Stage-specific URLs override the default URL above.
# CLOUD_TASKS_WORKER_URL_RECEIVED=https://svi-metadata-worker-dwstx3p4nq-ue.a.run.app/tasks/process
# CLOUD_TASKS_WORKER_URL_EXTRACTING_MEDIA=https://svi-media-worker-dwstx3p4nq-ue.a.run.app/tasks/process
# CLOUD_TASKS_WORKER_URL_TRANSCRIBING=https://svi-transcription-worker-dwstx3p4nq-ue.a.run.app/tasks/process
# CLOUD_TASKS_WORKER_URL_DISCOVERING_REPOSITORIES=https://svi-repository-discovery-worker-dwstx3p4nq-ue.a.run.app/tasks/process
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=svi-task-dispatcher@saved-video-intelligence.iam.gserviceaccount.com
